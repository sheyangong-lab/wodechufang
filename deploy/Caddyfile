# Caddy 反向代理 —— 站点骨架（三种模式的 tls 段由 deploy.sh 生成到 /config/Caddyfile.overlay）
#
# 模式说明见 deploy/README.md：
# 1. 域名模式   → 自动 Let's Encrypt（默认，无需 overlay）
# 2. IP 模式    → Caddy 自动 internal 自签（DOMAIN=IP，无需 overlay）
# 3. Lucky 证书 → deploy.sh 检测到 LUCKY_CERT_DIR 时在站点块里注入 tls 段：
#    tls /certs/域名.crt /certs/域名.key
#
# {$DOMAIN::443} 取环境变量；:443 兜底=任意 Host 都匹配。

{$DOMAIN::443} {
	encode zstd gzip

	# 上传图片/更新包较大，放开体积与超时
	request_body {
		max_size 20MB
	}

	reverse_proxy server:8080 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
