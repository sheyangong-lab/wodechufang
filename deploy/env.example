# 部署环境变量模板：复制为 .env 并填写（.env 不进 git）
# cp deploy/env.example .env && vi .env

# 你的域名（DNS A 记录指到部署机，Caddy 用它自动申请证书）
DOMAIN=example.com

# JWT 签名密钥（必填！openssl rand -base64 48 生成；泄露=任何人可伪造登录态）
JWT_SECRET=

# 智谱开放平台 Key（可选，账本票据 AI 识别用）
GLM_API_KEY=

# 数据库档位：dev=容器内 SQLite（默认，轻量够用）；prod=下方 Postgres
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://db:5432/sharedkitchen
# DB_USER=sharedkitchen
# DB_PASSWORD=
